<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PWManager.ViewModels" xmlns:views="using:PWManager.Views"
             xmlns:material="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="PWManager.Views.VaultPanel" x:DataType="vm:MainViewModel" Classes.compact="{Binding IsCompact}">
  <UserControl.KeyBindings>
    <KeyBinding Gesture="Ctrl+N" Command="{Binding NewEntryCommand}"/>
    <KeyBinding Gesture="Ctrl+S" Command="{Binding SaveEntryCommand}"/>
    <KeyBinding Gesture="Ctrl+L" Command="{Binding RequestLockCommand}"/>
    <KeyBinding Gesture="Escape" Command="{Binding EscapeCommand}"/>
  </UserControl.KeyBindings>
  <Panel>
    <Grid RowDefinitions="Auto,*,Auto" IsEnabled="{Binding !HasModal}">
      <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="24,20" Background="{StaticResource SurfaceBrush}">
        <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="16" IsEnabled="{Binding CanInteract}">
          <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center" Margin="0,0,16,0">
            <Border Width="40" Height="40" CornerRadius="12" Background="{StaticResource AccentSurfaceBrush}">
              <material:MaterialIcon Kind="ShieldKey" Width="23" Height="23" Foreground="{StaticResource FocusBrush}"/>
            </Border>
            <StackPanel Spacing="3" VerticalAlignment="Center">
              <TextBlock Text="PWManager" FontSize="16" FontWeight="SemiBold"/>
              <TextBlock Text="LOCAL VAULT" Classes="caption" FontSize="10" LetterSpacing="1.4"/>
              <TextBlock x:Name="VaultVersion" Text="{Binding VersionText}" Classes="caption" FontSize="10" LetterSpacing="1.4"
                         ToolTip.Tip="{Binding VersionToolTip}"/>
            </StackPanel>
          </StackPanel>
          <TextBox x:Name="SearchBox" Grid.Column="1" Text="{Binding SearchGlobal}"
                   PlaceholderText="Search entries…"
                   AutomationProperties.Name="Search entries" AutomationProperties.AcceleratorKey="Ctrl+F"
                   VerticalAlignment="Center"/>
          <Button x:Name="OpenSecuritySettings" Grid.Column="2" Classes="ghost icon" Command="{Binding OpenSecuritySettingsCommand}"
                  AutomationProperties.Name="Security" ToolTip.Tip="Security">
            <material:MaterialIcon Kind="ShieldLockOutline" Width="18" Height="18"/>
          </Button>
          <Button x:Name="OpenThemeSettings" Grid.Column="3" Classes="ghost icon" Command="{Binding OpenThemeSettingsCommand}"
                  AutomationProperties.Name="Appearance" ToolTip.Tip="Appearance">
            <material:MaterialIcon Kind="PaletteOutline" Width="18" Height="18"/>
          </Button>
          <Button x:Name="LockVault" Grid.Column="4" Classes="ghost icon" Command="{Binding RequestLockCommand}"
                  AutomationProperties.Name="Lock vault" ToolTip.Tip="Lock vault (Ctrl+L)">
            <material:MaterialIcon Kind="LockOutline" Width="18" Height="18"/>
          </Button>
          <Button x:Name="OpenGenerator" Grid.Column="5" Classes="ghost" Content="Generator" Command="{Binding OpenGeneratorCommand}"/>
          <Button Grid.Column="6" Classes="primary" Content="+  New entry" Command="{Binding NewEntryCommand}"
                  AutomationProperties.AcceleratorKey="Ctrl+N"/>
        </Grid>
      </Border>
      <Grid x:Name="Workspace" Grid.Row="1" ColumnDefinitions="360,24,*">
        <views:EntryListView x:Name="ListRegion" Grid.Column="0" IsVisible="{Binding ShowList}"/>
        <Border x:Name="PaneRegion" Grid.Column="2" Classes="panel" IsVisible="{Binding ShowPane}">
          <Grid RowDefinitions="Auto,*" RowSpacing="12">
            <Button x:Name="BackButton" Grid.Row="0" Classes="ghost" Content="←  Back to entries" Command="{Binding BackToEntriesCommand}"
                    HorizontalAlignment="Left" IsVisible="{Binding IsCompact}" Padding="0,4" IsEnabled="{Binding CanInteract}"/>
            <Grid Grid.Row="1" IsEnabled="{Binding CanInteract}">
              <views:EntryDetailsView IsVisible="{Binding ShowDetails}"/>
              <views:EntryEditorView IsVisible="{Binding IsEditorOpen}"/>
              <StackPanel IsVisible="{Binding ShowWelcome}" VerticalAlignment="Center" HorizontalAlignment="Center"
                          MaxWidth="320" Spacing="16">
                <Border Width="72" Height="72" CornerRadius="24" Background="{StaticResource AccentSurfaceBrush}" HorizontalAlignment="Center">
                  <material:MaterialIcon Kind="ShieldKeyOutline" Width="34" Height="34" Foreground="{StaticResource FocusBrush}"/>
                </Border>
                <TextBlock Text="Everything in its place" Classes="heading" TextAlignment="Center" TextWrapping="Wrap"/>
                <TextBlock Text="Select an entry to see its details, or add a password to your vault."
                           Classes="secondary" TextWrapping="Wrap" TextAlignment="Center" LineHeight="22"/>
                <Button Content="Create an entry" Command="{Binding NewEntryCommand}" HorizontalAlignment="Center" Margin="0,8,0,0"/>
              </StackPanel>
            </Grid>
          </Grid>
        </Border>
      </Grid>
      <Border Grid.Row="2" IsVisible="{Binding SavedEntryHidden}" Background="{StaticResource RaisedBrush}" Padding="24,8">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Text="The selected entry is hidden by your filters." Classes="secondary" VerticalAlignment="Center" TextWrapping="Wrap"/>
          <Button Grid.Column="1" Content="Clear filters" Classes="ghost" Command="{Binding ClearFiltersCommand}"/>
        </Grid>
      </Border>
    </Grid>

    <Border x:Name="GeneratorLayer" ZIndex="10" Background="{StaticResource ModalOverlayBrush}" IsVisible="{Binding IsGeneratorOpen}" Padding="24"
            KeyboardNavigation.TabNavigation="Cycle">
      <Border Classes="dialog" Width="540" MaxHeight="650" HorizontalAlignment="Center" VerticalAlignment="Center">
        <views:PasswordGeneratorView/>
      </Border>
    </Border>
    <Border x:Name="ThemeLayer" ZIndex="10" Background="{StaticResource ModalOverlayBrush}" IsVisible="{Binding IsThemeSettingsOpen}" Padding="24"
            KeyboardNavigation.TabNavigation="Cycle">
      <Border Classes="dialog" Width="640" MaxHeight="680" HorizontalAlignment="Center" VerticalAlignment="Center">
        <views:ThemeSettingsView DataContext="{Binding ThemeSettings}"/>
      </Border>
    </Border>
    <Border x:Name="SecurityLayer" ZIndex="10" Background="{StaticResource ModalOverlayBrush}" IsVisible="{Binding IsSecuritySettingsOpen}" Padding="24"
            KeyboardNavigation.TabNavigation="Cycle">
      <Border Classes="dialog" Width="640" MaxHeight="680" HorizontalAlignment="Center" VerticalAlignment="Center">
        <views:SecuritySettingsView DataContext="{Binding SecuritySettings}"/>
      </Border>
    </Border>
    <Border x:Name="DeleteLayer" ZIndex="10" Background="{StaticResource ModalOverlayBrush}" IsVisible="{Binding IsDeletePending}" Padding="24"
            KeyboardNavigation.TabNavigation="Cycle">
      <Border Classes="dialog" Width="440" HorizontalAlignment="Center" VerticalAlignment="Center">
        <StackPanel Spacing="16" IsEnabled="{Binding !IsBusy}">
          <TextBlock Text="Delete this entry?" Classes="heading"/>
          <TextBlock Text="{Binding SelectedEntry.Site}" FontWeight="SemiBold" TextWrapping="Wrap"/>
          <TextBlock Text="{Binding SelectedEntry.Login}" Classes="secondary" TextWrapping="Wrap"/>
          <TextBlock Text="This permanently removes the entry from your vault." Classes="secondary" TextWrapping="Wrap"/>
          <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button x:Name="CancelDelete" Content="Cancel" Command="{Binding CancelDeleteCommand}"/>
            <Button Content="Delete entry" Classes="danger" Command="{Binding ConfirmDeleteCommand}"/>
          </StackPanel>
        </StackPanel>
      </Border>
    </Border>
    <Border x:Name="DiscardLayer" ZIndex="10" Background="{StaticResource ModalOverlayBrush}" IsVisible="{Binding IsDiscardPending}" Padding="24"
            KeyboardNavigation.TabNavigation="Cycle">
      <Border Classes="dialog" Width="440" HorizontalAlignment="Center" VerticalAlignment="Center">
        <StackPanel Spacing="16">
          <TextBlock Text="Discard your changes?" Classes="heading"/>
          <TextBlock Text="Your changes haven't been saved. You can keep editing or discard them."
                     Classes="secondary" TextWrapping="Wrap"/>
          <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button x:Name="KeepEditing" Content="Keep editing" Command="{Binding KeepEditingCommand}"/>
            <Button Content="Discard changes" Classes="danger" Command="{Binding DiscardChangesCommand}"/>
          </StackPanel>
        </StackPanel>
      </Border>
    </Border>
    <Border x:Name="NotificationToast" ZIndex="5"
            IsVisible="{Binding Notification.IsVisible}" Opacity="{Binding Notification.Opacity}"
            Background="{StaticResource RaisedBrush}" BorderBrush="{StaticResource LineBrush}"
            BorderThickness="1" CornerRadius="12"
            HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="24,0,24,16" Padding="16,8" MaxWidth="650">
      <Border.Transitions>
        <Transitions>
          <DoubleTransition Property="Opacity" Duration="0:0:0.15"/>
        </Transitions>
      </Border.Transitions>
      <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
        <material:MaterialIcon Kind="CheckCircleOutline" Width="20" Height="20" Foreground="{StaticResource SuccessBrush}"
                               IsVisible="{Binding !Notification.IsError}"/>
        <material:MaterialIcon Kind="AlertCircleOutline" Width="20" Height="20" Foreground="{StaticResource DangerBrush}"
                               IsVisible="{Binding Notification.IsError}"/>
        <TextBlock Grid.Column="1" Text="{Binding Notification.Message}" TextWrapping="Wrap" VerticalAlignment="Center"
                   AutomationProperties.LiveSetting="Polite"/>
        <Button Grid.Column="2" Classes="ghost icon" Command="{Binding Notification.DismissCommand}"
                AutomationProperties.Name="Dismiss notification">
          <material:MaterialIcon Kind="Close" Width="16" Height="16"/>
        </Button>
      </Grid>
    </Border>
  </Panel>
</UserControl>
