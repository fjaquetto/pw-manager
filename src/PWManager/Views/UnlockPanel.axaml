<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PWManager.ViewModels"
             xmlns:material="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="PWManager.Views.UnlockPanel" x:DataType="vm:UnlockViewModel">
  <ScrollViewer HorizontalScrollBarVisibility="Disabled">
    <Grid Margin="36" RowDefinitions="Auto,*">
      <StackPanel Orientation="Horizontal" Spacing="10">
        <material:MaterialIcon Kind="ShieldKey" Width="24" Height="24" Foreground="{StaticResource FocusBrush}"/>
        <TextBlock Text="PWManager" FontWeight="SemiBold" VerticalAlignment="Center"/>
      </StackPanel>
      <StackPanel Grid.Row="1" Spacing="12" MaxWidth="360" HorizontalAlignment="Center" VerticalAlignment="Center">
        <Border Width="56" Height="56" CornerRadius="16" Background="{StaticResource AccentSurfaceBrush}" HorizontalAlignment="Center" Margin="0,0,0,12">
          <material:MaterialIcon Kind="LockOutline" Width="28" Height="28" Foreground="{StaticResource FocusBrush}"/>
        </Border>
        <TextBlock Text="{Binding Heading}" Classes="heading" FontSize="28" TextAlignment="Center"/>
        <TextBlock Text="{Binding Description}" Classes="secondary" TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,20"/>
        <TextBlock x:Name="MasterPasswordLabel" Text="Master password" FontWeight="Medium"/>
        <Grid IsEnabled="{Binding IsIdle}">
          <TextBox x:Name="PasswordBox" Text="{Binding Password}" PasswordChar="{Binding PasswordMask}"
                   Padding="12,10,48,10"
                   PlaceholderText="Enter master password" AutomationProperties.LabeledBy="{Binding #MasterPasswordLabel}"
                   AutomationProperties.AutomationId="MasterPassword">
            <TextBox.KeyBindings>
              <KeyBinding Gesture="Return" Command="{Binding UnlockCommand}"/>
            </TextBox.KeyBindings>
          </TextBox>
          <Button x:Name="PasswordVisibility" Classes="ghost icon" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,4,0"
                  Command="{Binding TogglePasswordVisibilityCommand}"
                  AutomationProperties.Name="{Binding VisibilityLabel}" ToolTip.Tip="{Binding VisibilityLabel}">
            <Grid><material:MaterialIcon Kind="EyeOutline" Width="20" Height="20" IsVisible="{Binding !IsPasswordVisible}"/><material:MaterialIcon Kind="EyeOffOutline" Width="20" Height="20" IsVisible="{Binding IsPasswordVisible}"/></Grid>
          </Button>
        </Grid>
        <StackPanel Spacing="8" IsVisible="{Binding IsCreating}">
          <TextBlock x:Name="ConfirmPasswordLabel" Text="Confirm master password" FontWeight="Medium"/>
          <TextBox x:Name="ConfirmPasswordBox" Text="{Binding ConfirmPassword}" PasswordChar="{Binding PasswordMask}"
                   PlaceholderText="Repeat master password" AutomationProperties.LabeledBy="{Binding #ConfirmPasswordLabel}"
                   AutomationProperties.AutomationId="ConfirmMasterPassword">
            <TextBox.KeyBindings>
              <KeyBinding Gesture="Return" Command="{Binding UnlockCommand}"/>
            </TextBox.KeyBindings>
          </TextBox>
        </StackPanel>
        <TextBlock Text="{Binding Notice}" Classes="caption" IsVisible="{Binding HasNotice}" TextWrapping="Wrap"
                   AutomationProperties.LiveSetting="Polite"/>
        <TextBlock Text="{Binding ErrorMessage}" Classes="error" IsVisible="{Binding HasError}" AutomationProperties.LiveSetting="Polite"/>
        <StackPanel Spacing="8" IsVisible="{Binding ShowProgress}" Margin="0,4,0,0">
          <ProgressBar IsIndeterminate="True" Height="4" AutomationProperties.Name="Unlocking"/>
          <TextBlock Text="{Binding ProgressText}" Classes="caption" HorizontalAlignment="Center" AutomationProperties.LiveSetting="Polite"/>
        </StackPanel>
        <Button x:Name="UnlockButton" Classes="primary" Command="{Binding UnlockCommand}" Content="{Binding ButtonLabel}"
                HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Margin="0,8,0,0" MinHeight="46"/>
        <Button x:Name="RestoreBackupButton" Content="Restore from backup…" Classes="ghost"
                Command="{Binding Restore.ChooseCommand}" IsVisible="{Binding ShowRestore}"
                HorizontalAlignment="Center" Margin="0,2,0,0"/>
        <StackPanel Spacing="4" HorizontalAlignment="Center" Margin="0,20,0,0">
          <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
            <material:MaterialIcon Kind="LockOutline" Width="14" Height="14" Foreground="{StaticResource SecondaryTextBrush}"/>
            <TextBlock Text="Stored locally. Encrypted on your device." Classes="caption"/>
          </StackPanel>
          <TextBlock x:Name="VersionLabel" Text="{Binding VersionText}" Classes="caption" HorizontalAlignment="Center"
                     ToolTip.Tip="{Binding VersionToolTip}"/>
        </StackPanel>
      </StackPanel>
    </Grid>
  </ScrollViewer>
</UserControl>
